<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="582.0" prefWidth="753.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carrybros.model.SignupController">
   <children>
      <Label layoutX="186.0" layoutY="52.0" prefHeight="95.0" prefWidth="381.0" text="Carry The Car" textAlignment="CENTER" textFill="#514b4b">
         <font>
            <Font name="Baskerville Old Face" size="64.0" />
         </font>
      </Label>
      <Label layoutX="266.0" layoutY="206.0" prefHeight="29.0" prefWidth="93.0" text="User Name">
         <font>
            <Font name="Agency FB Bold" size="24.0" />
         </font>
      </Label>
      <TextField layoutX="269.0" layoutY="244.0" prefHeight="35.0" prefWidth="217.0" fx:id="usernameField" promptText="Enter your username"/>

      <Label layoutX="266.0" layoutY="293.0" prefHeight="29.0" prefWidth="93.0" text="Full Name">
         <font>
            <Font name="Agency FB Bold" size="24.0" />
         </font>
      </Label>
      <TextField layoutX="269.0" layoutY="329.0" prefHeight="35.0" prefWidth="217.0" fx:id="fullnameField" promptText="Enter your full name"/>

      <Label layoutX="269.0" layoutY="374.0" prefHeight="29.0" prefWidth="87.0" text="Password">
         <font>
            <Font name="Agency FB Bold" size="24.0" />
         </font>
      </Label>
      <PasswordField layoutX="269.0" layoutY="413.0" prefHeight="35.0" prefWidth="217.0" fx:id="passwordField" promptText="Enter your password"/>

      <Button layoutX="421.0" layoutY="463.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Sign Up" onAction="#handleSignup">
         <font>
            <Font name="Agency FB" size="18.0" />
         </font>
      </Button>
   </children>
</Pane>
